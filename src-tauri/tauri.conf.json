{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kMonitor",
  "version": "0.1.0",
  "identifier": "com.kromaverso.kmonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1433",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kMonitor",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      },
      {
        "label": "mini",
        "title": "kMonitor Mini",
        "url": "index.html#mini",
        "width": 340,
        "height": 488,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "pawnio/PawnIO_setup.exe": "PawnIO_setup.exe"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}