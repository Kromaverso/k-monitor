{
  "Name": "kMonitor",
  "Version": "0.1.0.0",
  "Author": "Kromaverso",
  "Description": "Gauges de uso e temperatura de CPU, GPU e memória direto do kMonitor.",
  "UUID": "com.kromaverso.kmonitor",
  "Category": "kMonitor",
  "CategoryIcon": "imgs/category",
